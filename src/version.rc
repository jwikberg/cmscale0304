// The DLL's version resource, shown under Properties > Details in Explorer. mingw-build.sh generates version.h.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CMSCALE_VERSION_NUM
PRODUCTVERSION  CMSCALE_VERSION_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       CMSCALE_FILEFLAGS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "cmscale"
            VALUE "FileDescription",  "cmscale for Championship Manager 03/04"
            VALUE "FileVersion",      CMSCALE_VERSION_STR
            VALUE "InternalName",     "cmscale"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Joel Wikberg, MIT License"
            VALUE "OriginalFilename", "dsound.dll"
            VALUE "ProductName",      "cmscale"
            VALUE "ProductVersion",   CMSCALE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
